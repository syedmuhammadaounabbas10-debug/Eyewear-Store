{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile details including preferences and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isGuest": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "Order": {
      "title": "Order",
      "description": "Optical frame order placed by user or guest",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "totalPKR": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderId", "userId", "totalPKR", "paymentMethod", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Collection of user profile documents"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Collection of store orders"
    }
  }
}
